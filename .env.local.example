# Sorlio — environment variable reference.
#
# Copy to .env.local (gitignored) and fill in values there. This file lists
# NAMES and explains what each one is for; it deliberately carries no values,
# so nothing here can be mistaken for a real credential.
#
# Every variable the code reads is listed here, and nothing else. Secrets that
# must stay server-side and must never get a NEXT_PUBLIC_ prefix:
#   SUPABASE_SERVICE_ROLE_KEY, GOOGLE_PLAY_SERVICE_ACCOUNT_JSON,
#   OPENAI_API_KEY, CRON_SECRET, VALIDATION_ADMIN_TOKEN, KV/Upstash tokens.
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle.
#
# Sorlio has no analytics, crash reporting, email or feature-flag variables.
# If an older deployment still has NEXT_PUBLIC_ANALYTICS_*, *_SENTRY_*,
# RESEND_*, BETA_*, NEXT_PUBLIC_*_BETA_*, NEXT_PUBLIC_CLOSED_TEST_*,
# CLOSED_TEST_* or NEXT_PUBLIC_ADMIN_DASHBOARD_ENABLED set, nothing reads
# them: delete them from the host so they cannot be mistaken for live config.

# ---------------------------------------------------------------------------
# 1. Accounts and sync (Supabase)
# ---------------------------------------------------------------------------
# Public client credentials. The anon key grants only what row-level security
# and the sync RPCs allow (supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only; bypasses row-level security. Used by feedback, Premium
# verification and status, Google Play notifications, account deletion, the
# AI quota and the maintenance cron.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, usually unset. The server reads SUPABASE_URL || NEXT_PUBLIC_SUPABASE_URL;
# a stale value here silently points API routes at a different database.
SUPABASE_URL=

# ---------------------------------------------------------------------------
# 2. Premium and Google Play billing
# ---------------------------------------------------------------------------
# Product ID of the monthly subscription. Both must match; defaults to
# sorlio_premium_monthly.
NEXT_PUBLIC_GOOGLE_PLAY_PREMIUM_PRODUCT_ID=
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=

# Google Play service-account JSON, flattened to one line. Needs permission to
# view and acknowledge subscriptions.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Real-time developer notifications (Pub/Sub push to /api/premium/rtdn).
# The push subscription's OIDC audience and the service account it signs as;
# requests not signed by exactly this account for exactly this audience are
# refused. See docs/release/play-billing-manual-test.md.
RTDN_PUSH_AUDIENCE=
RTDN_PUSH_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# 3. Android app (Trusted Web Activity)
# ---------------------------------------------------------------------------
# SHA-256 fingerprint(s) of the Play App Signing certificate (comma-separated
# for upload + signing), served at /.well-known/assetlinks.json. Unset means
# domain verification fails and the app shows a browser URL bar.
ANDROID_APP_SHA256_CERT_FINGERPRINT=

# ---------------------------------------------------------------------------
# 4. AI features (OpenAI) — Premium only, server-enforced
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional model override.
OPENAI_MODEL=
# Optional anti-abuse ceiling on AI calls per account per day (default 300).
# Also set a hard spend cap in the OpenAI dashboard.
AI_DAILY_CALL_LIMIT=

# ---------------------------------------------------------------------------
# 5. Scheduled jobs and shared store
# ---------------------------------------------------------------------------
# Shared secret for the Vercel cron routes (/api/cron/*). Required in production.
CRON_SECRET=

# Redis/KV for rate limits, admin-session revocation and the news article
# cache. Required in production: without it rate-limited routes and admin
# sign-out fail closed. Set either pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# 6. Deployment identity
# ---------------------------------------------------------------------------
# local | preview | production. Defaults from Vercel's own VERCEL_ENV.
NEXT_PUBLIC_DEPLOYMENT_ENV=
# Version label shown in feedback rows; defaults to the commit SHA.
NEXT_PUBLIC_APP_VERSION=
# Canonical origin for metadata, canonical URLs, robots.txt and the sitemap.
# Defaults to https://sorlio.site; set it on previews. OAuth redirects use
# window.location.origin and do not read this.
NEXT_PUBLIC_PRODUCTION_DOMAIN=

# ---------------------------------------------------------------------------
# 7. Admin access (feedback reader)
# ---------------------------------------------------------------------------
# Signs in to /admin/feedback (8-hour, revocable sessions) and works as a
# bearer token for scripts. Rotating it signs out every admin session.
VALIDATION_ADMIN_TOKEN=
