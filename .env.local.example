# Sorlio — environment variable reference.
#
# Copy to .env.local (gitignored) and fill in values there. This file lists
# NAMES and explains what each one is for; it deliberately carries no values,
# including no "example" ones, so nothing here can be mistaken for a real
# credential or copied into production by accident.
#
# Never commit real keys. Three of these are secrets that must stay
# server-side and must never be given a NEXT_PUBLIC_ prefix:
#   SUPABASE_SERVICE_ROLE_KEY, GOOGLE_PLAY_SERVICE_ACCOUNT_JSON, OPENAI_API_KEY
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle and is
# readable by anyone using the app.
#
# ---------------------------------------------------------------------------
# 1. Accounts and sync (Supabase)
# ---------------------------------------------------------------------------
# Public client credentials. Safe in the browser: the anon key grants only
# what the row-level-security policies in supabase/release-migration.sql
# allow, and auth.uid() comes from a JWT Supabase verifies server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. The service-role key bypasses row-level security
# entirely, so it belongs in the server environment and nowhere else —
# never in client code, never in a committed file, never NEXT_PUBLIC_.
# Used by the analytics, feedback, research-prompt, beta, premium
# verification, and account-deletion API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, and usually best left unset. The server client reads
# SUPABASE_URL || NEXT_PUBLIC_SUPABASE_URL, so this only matters if you
# deliberately want API routes on a different project from the browser.
# Left holding a stale value it is a silent split-brain: sign-in uses one
# database while every API route uses another.
SUPABASE_URL=

# ---------------------------------------------------------------------------
# 2. Premium and Google Play billing
# ---------------------------------------------------------------------------
# Product ID of the monthly auto-renewing subscription. Both names must hold
# the same value; the code defaults to sorlio_premium_monthly if unset.
NEXT_PUBLIC_GOOGLE_PLAY_PREMIUM_PRODUCT_ID=
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=

# Full Google Play service-account JSON, flattened to one line. Server-side
# only. Needs permission to view subscriptions and acknowledge purchases.
# Paste the real JSON into .env.local or your host's secret store — never
# into this file or any other tracked file.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# 3. Android app (Trusted Web Activity)
# ---------------------------------------------------------------------------
# SHA-256 fingerprint of the Play App Signing certificate, used to serve
# /.well-known/assetlinks.json. Comma-separate multiple fingerprints (for
# example the upload certificate and the Play signing certificate). While
# this is unset the assetlinks route returns an empty array, which means
# domain verification fails and the app shows a browser URL bar.
ANDROID_APP_SHA256_CERT_FINGERPRINT=

# ---------------------------------------------------------------------------
# 4. AI features (OpenAI)
# ---------------------------------------------------------------------------
# Server-side only. Without it the AI-backed explain/paraphrase/translate
# actions show an "AI is not configured" message and everything else works.
OPENAI_API_KEY=
# Optional model override; the code defaults to a small, fast chat model.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# 5. Content pipeline (RSS)
# ---------------------------------------------------------------------------
# Shared secret so scheduled jobs can warm the RSS pool. Required in
# production if the cron route is enabled.
CRON_SECRET=

# Optional Redis/KV so RSS article links survive a restart. Without them RSS
# texts live only in the current tab's sessionStorage. Set either pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# 6. Feature flags
# ---------------------------------------------------------------------------
# All are optional and all have safe code defaults — see
# src/lib/validation/config.ts. Three of these default to FALSE on purpose
# and must stay unset (or false) in a public production build, because each
# exposes something a paying reader should never see:
#   NEXT_PUBLIC_ADMIN_DASHBOARD_ENABLED  the internal validation dashboard
#   NEXT_PUBLIC_BETA_BANNER_ENABLED      an "in active beta" notice
#   NEXT_PUBLIC_ANDROID_BETA_CTA_ENABLED an Android beta waiting-list CTA,
#                                        which is incoherent inside the
#                                        shipped Android app itself
NEXT_PUBLIC_ADMIN_DASHBOARD_ENABLED=
NEXT_PUBLIC_BETA_BANNER_ENABLED=
NEXT_PUBLIC_ANDROID_BETA_CTA_ENABLED=

# Default to true; set to false to disable.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_FEEDBACK_ENABLED=
NEXT_PUBLIC_POST_SESSION_PROMPTS_ENABLED=
NEXT_PUBLIC_PRODUCT_DISAPPEARANCE_SURVEY_ENABLED=

# Analytics are sent only from a production deployment unless this is true.
NEXT_PUBLIC_ANALYTICS_INCLUDE_NON_PRODUCTION=

# ---------------------------------------------------------------------------
# 7. Deployment identity
# ---------------------------------------------------------------------------
# Environment label and version string attached to analytics, feedback, and
# research rows.
#
# NEXT_PUBLIC_PRODUCTION_DOMAIN is the canonical production origin, and it is
# the single place the domain is configured: metadataBase, canonical and Open
# Graph URLs, robots.txt, the sitemap, acquisition-attribution parsing, and
# the beta unsubscribe link all derive from it. The code defaults to
# https://sorlio.site, so production can leave it unset — set it on a preview
# deployment so the preview declares itself instead of claiming to be
# production.
#
# OAuth redirects do NOT read this. Sign-in uses window.location.origin, so
# it follows whatever host the app is actually served from, including
# localhost. That is why development sign-in needs no separate setting.
NEXT_PUBLIC_DEPLOYMENT_ENV=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_PRODUCTION_DOMAIN=

# ---------------------------------------------------------------------------
# 8. Admin access
# ---------------------------------------------------------------------------
# Bearer token the validation dashboard sends to read its protected data
# route. Only relevant when NEXT_PUBLIC_ADMIN_DASHBOARD_ENABLED is true.
VALIDATION_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 9. Transactional email (optional)
# ---------------------------------------------------------------------------
# Confirmation email for Android beta sign-ups, sent through Resend. Leave
# the flag unset to skip email entirely. BETA_CONFIRMATION_FROM is the
# visible sender address on mail readers receive, so it must be a Sorlio
# address (Sorlio@proton.me or a sending domain) and never a personal one.
NEXT_PUBLIC_EMAIL_CONFIRMATION_ENABLED=
RESEND_API_KEY=
BETA_CONFIRMATION_FROM=

# ---------------------------------------------------------------------------
# 10. Error monitoring (optional)
# ---------------------------------------------------------------------------
# A Sentry DSN is a write-only endpoint identifier rather than a secret, so
# exposing it to the browser is expected. The auth token is only needed to
# upload source maps at build time and must stay server-side.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
